# SentinelX AI - Environment Configuration Template
APP_NAME="SentinelX AI"
ENVIRONMENT="development"
# Critical safety boundary: SentinelX AI MUST run in simulation mode.
EXECUTION_MODE="simulation"
API_PREFIX="/api/v1"
HOST="127.0.0.1"
PORT=8000

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://sentinelx:sentinelx@localhost:5432/sentinelx_db"

# Security (for future JWT/auth integration)
SECRET_KEY="sentinelx-dev-secret-key-replace-in-production"
